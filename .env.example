# Createtor — environment template
#
# Copy to `.env` for local development. `.env` is gitignored; NEVER commit real
# keys. Rules for this project:
#   - Only PUBLIC values may carry a `VITE_` prefix (anything with `VITE_` is
#     embedded into the browser bundle). Never put a secret behind `VITE_`.
#   - Production secrets belong in Cloudflare Workers secrets (wrangler secret
#     put <NAME>) or, for payment keys, in the admin dashboard (Settings →
#     Payments), which stores them in `system_settings` and overrides env vars.
#   - Keep MIGRATION_DATABASE_URL empty in production: no direct Postgres
#     connection should be reachable from the internet. All data access goes
#     through PostgREST (RLS) or the server-side service role.

# --- Environment separation ------------------------------------------------
# Development must not point at the production database. Vite loads
# `.env` then `.env.[mode]` then `.env.[mode].local`. Put local values in
# `.env.development` (or `.env.local`) and keep production values in the deploy
# platform's environment, never in a committed file.
#
# Set the production target once (any of these). When a NON-production build
# resolves the same Supabase project, the server refuses to boot instead of
# risking real customer data.
# APP_ENV="development"                 # optional override of NODE_ENV/mode
# PRODUCTION_SUPABASE_PROJECT_ID="your-prod-project-ref"
# PRODUCTION_SUPABASE_URL="https://your-prod-project-ref.supabase.co"
# ALLOW_PRODUCTION_DATA="1"             # deliberate escape hatch; avoid in dev
#
# Migration + staging tooling (see docs/migrations.md). These are for operators
# running schema changes: set them for the command you run, never on the live
# app. Use the DIRECT Postgres URI (port 5432), not the connection pooler.
# MIGRATION_DATABASE_URL="postgresql://postgres:...@db.<staging-ref>.supabase.co:5432/postgres"
# LIVE_DATABASE_URL="postgresql://postgres:...@db.<prod-ref>.supabase.co:5432/postgres"
# STAGING_DATABASE_URL="postgresql://postgres:...@db.<staging-ref>.supabase.co:5432/postgres"
# PGBIN="C:\\Program Files\\PostgreSQL\\17\\bin"   # folder with pg_dump/psql

# --- Supabase (required) ----------------------------------------------------
# Server-only. SUPABASE_SERVICE_ROLE_KEY is a secret: server functions only.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Browser bundle (same publishable values — safe to expose).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Exact OAuth return URL for "Continue with Google". Must match, character for
# character, an entry in Google's "Authorized redirect URIs" AND Supabase's
# Auth → URL Configuration → Redirect URLs allowlist. Leave unset in local dev
# to fall back to <current origin>/auth.
# VITE_OAUTH_REDIRECT_URL="https://your-domain.example/auth"

# --- AI providers (required for generation) ---------------------------------
GOOGLE_AI_API_KEY="..."
GEMINI_CHAT_MODEL="gemini-3.5-flash"
GEMINI_API_BASE_URL=""
GEMINI_IMAGE_MODEL=""
GEMINI_TTS_MODEL=""
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL=""
FALLBACK_AI_API_KEY=""
FALLBACK_AI_BASE_URL=""
FALLBACK_AI_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""
OPENROUTER_MODEL=""
POLLINATIONS_TOKEN=""
POLLINATIONS_MODEL="flux"
IMAGE_PROVIDER="pollinations"

# --- Video gateway (optional) ----------------------------------------------
VIDEO_PROVIDER=""
VIDEO_API_KEY=""
VIDEO_MODEL=""
VIDEO_RESOLUTION=""
FAL_KEY=""

# --- App origin -------------------------------------------------------------
# Public origin used to build checkout + webhook return URLs. REQUIRED for
# checkout in production: it no longer falls back to the request Host header
# (that allowed return-URL poisoning). Outside production, localhost is allowed.
# APP_URL="https://your-domain.example"
# PUBLIC_APP_URL="https://your-domain.example"

# --- Payments (optional; dashboard keys override these) ---------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET="whsec_..."   # from `stripe listen` or dashboard endpoint
# PAYPAL_MODE="sandbox"               # or "live"
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_WEBHOOK_ID=""
#
# Plan prices are NOT set here. Configure the amount charged and the Stripe
# price id per plan/cycle in the admin console (Settings -> Plan pricing), which
# stores them in `system_settings` (key `pricing`). Checkout uses that config;
# the fields in src/lib/pricing.ts are only fallback defaults.

# --- Content Security Policy ------------------------------------------------
# The app is same-origin; the only third-party script is Cloudflare Turnstile and
# it runs on /auth only. A strict CSP is emitted report-only first (violations are
# collected at /api/csp-report instead of breaking the page). Set this to true
# once the report-only logs are clean to switch the same policy to enforcing.
# CSP_ENFORCE="false"

# --- Distributed rate limiting (optional) ----------------------------------
# When both are set, the limiter uses Upstash Redis (a single REST round-trip)
# and falls back to the Postgres limiter on any Redis error. Leave unset to use
# the Postgres limiter only (already global across Worker isolates).
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# --- API request signing (machine callers) ----------------------------------
# Server-to-server clients can call mutating endpoints (/api/v1/*) with an HMAC
# signature instead of a session token. One key per integration so a single pair
# can be rotated: `kid1:secret1,kid2:secret2` (secrets >= 16 chars, kid is
# [A-Za-z0-9_-]). Browsers never sign — they keep using the session JWT.
# See docs/api-versioning.md for the canonical string and header names.
# API_SIGNING_KEYS=""
# API_SIGNING_SECRET=""              # single implicit `default` key
# API_SIGNING_MAX_SKEW_SECONDS="300" # ± window for X-Timestamp (max 3600)

# --- Access control ---------------------------------------------------------
# Comma-separated allowlist of emails allowed to claim the bootstrap super
# admin. REQUIRED: when unset, the first-admin claim is refused (fail closed),
# so a fresh deployment cannot be hijacked by whoever signs in first.
# ADMIN_EMAILS="admin@your-domain.example"

# Secret first path segment for the admin console, e.g. ADMIN_PATH="control-7f3a".
# When set, the console is reachable at /<ADMIN_PATH>/* and the literal /admin
# returns 404, so the console cannot be found by guessing. Lowercase letters,
# digits and dashes (3-64 chars); reserved words like "api" are rejected. When
# unset, the console stays at /admin.
# ADMIN_PATH="control-7f3a"

# Scheduled job auth (bearer token for cron/worker endpoints; rotate if exposed).
# CRON_SECRET=""
# CRON_SECRET_PREVIOUS=""

# --- Privacy / PII (recommended) -------------------------------------------
# Salt for pseudonymising client IPs before they are stored (audit logs,
# security events, request logs, admin rate-limit keys). Set a long random
# value; rotating it re-pseudonymises future writes (older hashes stay put).
# When unset, a fixed fallback salt is used, so a raw IP is still never stored.
# IP_HASH_SALT="a-long-random-string"

# --- Bot protection (optional) ---------------------------------------------
# Public site key, safe to expose. Pair with the Turnstile *secret* key
# configured in Supabase: Auth → Protection → Bot and Abuse Protection.
# VITE_TURNSTILE_SITE_KEY="0x4AAAAAAA..."

# --- Database migrations (local/CI only) ------------------------------------
# Leave unset in production. Used solely by `drizzle-kit` when running migrations.
# MIGRATION_DATABASE_URL="postgresql://..."
