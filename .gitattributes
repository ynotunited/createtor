# Normalize line endings to LF in the repository.
# Prettier/eslint expect LF, and the app targets Linux/Cloudflare.
# Git stores LF; working tree gets LF on all platforms (no CRLF churn).
* text=auto eol=lf

# Binary files must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.zip binary

# Keep scripts and lockfiles as LF explicitly.
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf

# Diffs for lockfiles and generated files.
package-lock.json -diff
bun.lock -diff
*.png -diff
